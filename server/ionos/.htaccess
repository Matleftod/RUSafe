# Redirect every clear-text or www request to the canonical HTTPS host.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.rusafe\.fr$ [NC]
RewriteRule ^ https://rusafe.fr%{REQUEST_URI} [R=301,L,NE]

# Keep Apache's 404 status while using the generated, root-aware error page.
ErrorDocument 404 __BASE_PATH__/404.html

Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(?:env|ini|log|sql|bak)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Pages change often; they must be revalidated on every navigation.
  <FilesMatch "\.(?:html?)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # CSS and JavaScript keep stable filenames, so use a short cache lifetime.
  <FilesMatch "\.(?:css|js)$">
    Header always set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # Binary assets are rarely replaced under the same name; one day is a safe
  # performance gain without making a manual deployment hard to verify.
  <FilesMatch "\.(?:woff2?|png|jpe?g|webp|svg|ico|mp4|webm)$">
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
